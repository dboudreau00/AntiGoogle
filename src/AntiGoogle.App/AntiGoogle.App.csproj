<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AntiGoogle.App</RootNamespace>
    <AssemblyName>AntiGoogle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Surfaced on the About page and in the exe's file properties. -->
    <Version>0.2.0</Version>
    <Product>Anti-Google</Product>
    <AssemblyTitle>Anti-Google</AssemblyTitle>
    <Description>Removes Google telemetry from Windows, and tells you what that breaks first.</Description>
    <Company>Anti-Google</Company>
    <Copyright>Use at your own risk.</Copyright>

    <!-- The exe's shell icon (Explorer, taskbar pin, alt-tab). Generated by tools/AntiGoogle.IconGen
         from Logo.xaml - do not hand-edit the .ico, regenerate it. -->
    <ApplicationIcon>Assets\AntiGoogle.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also needed as a Resource: ApplicationIcon only sets the FILE icon. Window.Icon resolves
         its URI against the assembly's resources, so without this the window and taskbar button
         fall back to the generic WPF icon - and the XAML type converter throws at load. -->
    <Resource Include="Assets\AntiGoogle.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiGoogle.Core\AntiGoogle.Core.csproj" />
  </ItemGroup>

</Project>
