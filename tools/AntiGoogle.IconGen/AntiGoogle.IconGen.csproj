<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the app's logo geometry to a multi-resolution .ico.

    Deliberately a separate tool rather than a build step: the icon changes only when the logo does,
    and a design tool that runs on every build is a tax on every build. Run it by hand with
    "dotnet run" against this project directory.

    It reads src/AntiGoogle.App/Logo.xaml, so the window mark and the taskbar icon can never drift
    apart - there is exactly one definition of the logo in the repo.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>AntiGoogle.IconGen</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
